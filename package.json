{
  "name": "omp-instance-control",
  "version": "0.2.0",
  "description": "Native ompi wrapper and OMP adapter for scoped settled-boundary restart/resume.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/omp-instance-control.git"
  },
  "homepage": "https://github.com/klondikemarlen/omp-instance-control#readme",
  "bugs": {
    "url": "https://github.com/klondikemarlen/omp-instance-control/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "omp": {
    "extensions": [
      "./omp/index.js"
    ]
  },
  "files": [
    "cli/",
    "linux/",
    "omp/",
    "protocol/",
    "README.md",
    "CONCEPTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "make build",
    "test": "go test ./... && node --test",
    "format": "gofmt -w cli linux protocol test && prettier --write .",
    "check": "go vet ./... && prettier --check . && test -z \"$(gofmt -l cli linux protocol test)\""
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
