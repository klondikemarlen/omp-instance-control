# Bash completion for the native ompi wrapper.

_ompi_omp_completion()
{
    # Reuse the installed OMP catalog, including its dynamic value completions.
    if ! declare -F _omp >/dev/null; then
        command -v omp >/dev/null 2>&1 || return 0
        local omp_registration
        omp_registration=$(complete -p omp 2>/dev/null) || omp_registration=""
        source <(command omp completions bash 2>/dev/null)
        # The delegated catalog registers omp too; only ompi belongs to us.
        if [[ -n $omp_registration ]]; then
            eval "$omp_registration"
        else
            complete -r omp 2>/dev/null || :
        fi
    fi

    if declare -F _omp >/dev/null; then
        _omp "$@"
    fi
}

_ompi_restore_completion()
{
    local cur prev words cword
    _comp_initialize -n = || return

    case "$prev" in
        --profile|--instance) return 0 ;;
    esac

    local action=""
    local have_name=false
    local listing=false
    local options
    local index
    local -a profile_arguments=()
    for (( index=2; index<cword; index++ )); do
        case ${words[index]} in
            --profile)
                profile_arguments=(--profile "${words[index+1]}")
                (( index++ ))
                ;;
            --profile=*)
                profile_arguments=(--profile "${words[index]#--profile=}")
                ;;
            --instance)
                (( index++ ))
                ;;
            save)
                action=save
                ;;
            --list)
                listing=true
                ;;
            --json|--help|-h)
                ;;
            -*)
                ;;
            *)
                if [[ $action != save ]]; then
                    have_name=true
                elif [[ $have_name == false ]]; then
                    have_name=true
                fi
                ;;
        esac
    done

    if [[ $action == save && $have_name == false ]]; then
        return 0
    fi

    if [[ $action == save ]]; then
        options='--instance --profile --help -h --version'
    elif [[ $listing == true ]]; then
        options='--json --profile --help -h --version'
    elif [[ $have_name == true ]]; then
        options='--profile --help -h --version'
    else
        options='save --profile --list --help -h --version'
    fi
    COMPREPLY=( $(compgen -W "$options" -- "$cur") )

    if [[ $action != save && $have_name == false && $listing == false && $cur != -* ]]; then
        local IFS=$' \t'
        local list_position
        local saved_name
        local remainder
        local -a saved_names=()
        while read -r list_position saved_name remainder; do
            [[ $list_position =~ ^[0-9]+\)$ ]] || continue
            saved_names+=("$saved_name")
        done < <(command ompi restore "${profile_arguments[@]}" --list 2>/dev/null)
        COMPREPLY+=( $(compgen -W "${saved_names[*]}" -- "$cur") )
    fi
}

_ompi()
{
    local cur prev words cword
    _comp_initialize -n = || return

    if (( cword == 1 )); then
        _ompi_omp_completion "$@"
        if [[ instances == "$cur"* ]]; then
            COMPREPLY+=(instances)
        fi
        if [[ restore == "$cur"* ]]; then
            COMPREPLY+=(restore)
        fi
        return 0
    fi

    if [[ ${words[1]} == restore ]]; then
        _ompi_restore_completion "$@"
        return 0
    fi

    if [[ ${words[1]} != instances ]]; then
        _ompi_omp_completion "$@"
        return 0
    fi

    local options='--profile --json --help -h --version'
    if (( cword == 2 )); then
        COMPREPLY=( $(compgen -W "list restart cleanup $options" -- "$cur") )
        return 0
    fi

    local action=list
    case ${words[2]} in
        list|restart|cleanup) action=${words[2]} ;;
        -*) ;;
        *) return 0 ;;
    esac

    # Values are free-form here; do not mistake them for actions or options.
    case "$prev" in
        --profile|--instance) return 0 ;;
    esac
    [[ $cur == *=* ]] && return 0

    local index
    for (( index=2; index<cword; index++ )); do
        case ${words[index]} in
            --profile|--instance) (( index++ )) ;;
            --) return 0 ;;
        esac
    done

    if [[ $action == restart ]]; then
        options+=' --all --instance --no-wait'
    fi
    COMPREPLY=( $(compgen -W "$options" -- "$cur") )
    return 0
}


complete -F _ompi ompi
