# Bash completion for the native ompi wrapper.

_ompi_omp_completion()
{
    # Reuse the installed OMP catalog, including its dynamic value completions.
    if ! declare -F _omp >/dev/null; then
        command -v omp >/dev/null 2>&1 || return 0
        local omp_registration
        omp_registration=$(complete -p omp 2>/dev/null) || omp_registration=""
        source <(command omp completions bash 2>/dev/null)
        # The delegated catalog registers omp too; only ompi belongs to us.
        if [[ -n $omp_registration ]]; then
            eval "$omp_registration"
        else
            complete -r omp 2>/dev/null || :
        fi
    fi

    if declare -F _omp >/dev/null; then
        _omp "$@"
    fi
}

_ompi_control_completion()
{
    local cur prev words cword
    _comp_initialize -n = || return
    COMPREPLY=()
    if (( cword == 2 )); then
        COMPREPLY=( $(compgen -W 'list restart restore cleanup help version' -- "$cur") )
        return 0
    fi
    local action=${words[2]}
    if [[ $action == help ]]; then
        if (( cword == 3 )); then
            COMPREPLY=( $(compgen -W 'list restart restore cleanup version' -- "$cur") )
        fi
        return 0
    fi
    [[ $action == list || $action == restart || $action == cleanup || $action == restore ]] || return 0

    local index token name next pending='' selector='' selector_prefix=''
    local -A used=()
    local -a positionals=() profile_arguments=()
    for (( index=3; index<cword; index++ )); do
        token=${words[index]}
        [[ $token == -- ]] && return 0
        if [[ $token != -* ]]; then
            positionals+=("$token")
            continue
        fi
        name=${token%%=*}
        [[ $name == -h ]] && name=--help
        used[$name]=1
        case $name in
            --help|--version) return 0 ;;
            --profile|--instance|--from)
                if [[ $token == *=* ]]; then
                    [[ $name == --profile ]] && profile_arguments=(--profile "${token#*=}")
                    continue
                fi
                if (( index+1 >= cword )); then
                    pending=$name
                    break
                fi
                next=${words[index+1]}
                if [[ $next == = ]]; then
                    (( index++ ))
                    if (( index+1 >= cword )); then
                        pending=$name
                        break
                    fi
                    next=${words[index+1]}
                fi
                [[ $next == -* ]] && return 0
                [[ $name == --profile ]] && profile_arguments=(--profile "$next")
                (( index++ ))
                ;;
        esac
    done

    local options='--profile --json' operation=${positionals[0]} needs_argument=false
    if [[ $action == restart ]]; then
        options+=' --no-wait'
        (( ${#positionals[@]} > 1 )) && return 0
    elif [[ $action == restore ]]; then
        options='--profile'
        case $operation in
            list) options='--json --from --profile' ;;
            history) options='--json --profile' ;;
            export) options='--from --profile' ;;
            save) options='--instance --profile'; needs_argument=true ;;
            name|slot|from) needs_argument=true ;;
        esac
        local maximum=1
        [[ $needs_argument == true || $operation == import-legacy ]] && maximum=2
        (( ${#positionals[@]} > maximum )) && return 0
    elif (( ${#positionals[@]} > 0 )); then
        return 0
    fi
    for name in "${!used[@]}"; do
        [[ " $options " == *" $name "* ]] || return 0
    done
    case $pending in
        --profile|--instance) return 0 ;;
        --from) selector=from ;;
    esac
    case $cur in
        --profile=*|--instance=*) return 0 ;;
        --from=*) selector=from; selector_prefix='--from=' ;;
    esac
    if [[ $action == restore && $needs_argument == true && ${#positionals[@]} == 1 ]]; then
        case $operation in
            slot|from) selector=$operation ;;
            save) return 0 ;;
            name) ;;
        esac
    fi
    if [[ -n $selector ]]; then
        [[ $action == restore ]] || return 0
        if [[ -n $selector_prefix || $pending == --from ]]; then
            [[ $operation == list || $operation == export ]] || return 0
        fi
        local position saved_name identity remainder
        local -a identities=()
        if [[ $selector == from ]]; then
            while read -r position identity remainder; do
                [[ $position =~ ^[0-9]+\)$ && $identity =~ ^[a-f0-9]{32}$ ]] || continue
                identities+=("$selector_prefix$identity")
            done < <(command ompi control restore history "${profile_arguments[@]}" 2>/dev/null)
        else
            while read -r position saved_name identity remainder; do
                [[ $position =~ ^[0-9]+\)$ && $identity =~ ^[a-f0-9]{32}$ ]] || continue
                identities+=("$identity")
            done < <(command ompi control restore list "${profile_arguments[@]}" 2>/dev/null)
        fi
        COMPREPLY=( $(compgen -W "${identities[*]}" -- "$cur") )
        return 0
    fi
    [[ -n $pending ]] && return 0
    if [[ $cur != -* ]]; then
        if [[ $action == restart && ${#positionals[@]} == 0 ]]; then
            COMPREPLY=( $(compgen -W 'all' -- "$cur") )
        elif [[ $action == restore && ( ${#positionals[@]} == 0 || ( $operation == name && ${#positionals[@]} == 1 ) ) ]]; then
            local position saved_name remainder
            local verbs='list history checkpoint export import-legacy slot from save name'
            local -a names=()
            [[ -z $operation ]] && names=($verbs)
            while read -r position saved_name remainder; do
                [[ $position =~ ^[0-9]+\)$ && $saved_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || continue
                [[ -z $operation && " $verbs " == *" $saved_name "* ]] && continue
                names+=("$saved_name")
            done < <(command ompi control restore list "${profile_arguments[@]}" 2>/dev/null)
            COMPREPLY=( $(compgen -W "${names[*]}" -- "$cur") )
        elif [[ $action == restore && $operation == import-legacy && ${#positionals[@]} == 1 ]]; then
            _comp_compgen_filedir
        fi
        return 0
    fi
    [[ $needs_argument == true && ${#positionals[@]} == 1 ]] && return 0
    local option
    local -a available=()
    for option in $options; do
        [[ -n ${used[$option]} ]] || available+=("$option")
    done
    COMPREPLY=( $(compgen -W "${available[*]}" -- "$cur") )
    return 0
}

_ompi()
{
    local cur prev words cword
    _comp_initialize -n = || return
    if (( cword == 1 )); then
        _ompi_omp_completion "$@"
        [[ control == "$cur"* ]] && COMPREPLY+=(control)
        return 0
    fi
    if [[ ${words[1]} == control ]]; then
        _ompi_control_completion "$@"
    else
        _ompi_omp_completion "$@"
    fi
}

complete -F _ompi ompi
