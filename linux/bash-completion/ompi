# Bash completion for the native ompi wrapper.

_ompi_omp_completion()
{
    # Reuse the installed OMP catalog, including its dynamic value completions.
    if ! declare -F _omp >/dev/null; then
        command -v omp >/dev/null 2>&1 || return 0
        local omp_registration
        omp_registration=$(complete -p omp 2>/dev/null) || omp_registration=""
        source <(command omp completions bash 2>/dev/null)
        # The delegated catalog registers omp too; only ompi belongs to us.
        if [[ -n $omp_registration ]]; then
            eval "$omp_registration"
        else
            complete -r omp 2>/dev/null || :
        fi
    fi

    if declare -F _omp >/dev/null; then
        _omp "$@"
    fi
}

_ompi_control_completion()
{
    local cur prev words cword
    _comp_initialize -n = || return
    COMPREPLY=()

    local commands='list restart restore cleanup help version'
    if (( cword == 2 )); then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    local action=${words[2]}
    if [[ $action == help ]]; then
        if (( cword == 3 )); then
            COMPREPLY=( $(compgen -W 'list restart restore cleanup version' -- "$cur") )
        fi
        return 0
    fi
    [[ $action == list || $action == restart || $action == cleanup || $action == restore ]] || return 0

    local index token name next operation='' pending='' selector='' selector_prefix=''
    local positionals=0 save=false operation_count=0
    local -A used=()
    local -a profile_arguments=()
    for (( index=3; index<cword; index++ )); do
        token=${words[index]}
        [[ $token == -- ]] && return 0
        if [[ $token != -* ]]; then
            if [[ $action == restore && $positionals == 0 && $token == save ]]; then
                save=true
            fi
            (( positionals++ ))
            continue
        fi

        name=${token%%=*}
        [[ $name == -h ]] && name=--help
        used[$name]=1
        case $name in
            --help|--version) return 0 ;;
            --list|--checkpoint|--history|--export|--import-legacy|--slot)
                operation=$name
                (( operation_count++ ))
                ;;
        esac
        case $name in
            --profile|--instance|--from|--slot|--import-legacy)
                if [[ $token == *=* ]]; then
                    [[ $name == --profile ]] && profile_arguments=(--profile "${token#*=}")
                    continue
                fi
                if (( index+1 >= cword )); then
                    pending=$name
                    continue
                fi
                next=${words[index+1]}
                if [[ $name == --import-legacy && $next == -* ]]; then
                    continue
                fi
                if [[ $next == = ]]; then
                    if (( index+2 >= cword )); then
                        pending=$name
                        continue
                    fi
                    (( index++ ))
                    next=${words[index+1]}
                fi
                [[ $name == --profile ]] && profile_arguments=(--profile "$next")
                (( index++ ))
                ;;
        esac
    done

    (( operation_count > 1 )) && return 0
    if [[ -n ${used[--from]} && -n $operation && $operation != --list && $operation != --export ]]; then
        return 0
    fi
    if [[ $action == restore && $positionals -gt 0 && ( -n $operation || -n ${used[--from]} ) ]]; then
        return 0
    fi
    case $pending in
        --profile|--instance) return 0 ;;
        --from|--slot) selector=$pending ;;
        --import-legacy)
            if [[ $cur != -* ]]; then
                _comp_compgen_filedir
                return 0
            fi
            ;;
    esac
    case $cur in
        --profile=*|--instance=*) return 0 ;;
        --from=*|--slot=*) selector=${cur%%=*}; selector_prefix="$selector=" ;;
        --import-legacy=*) return 0 ;;
    esac
    if [[ -n $selector ]]; then
        [[ $action == restore && $positionals == 0 ]] || return 0
        if [[ $selector == --from ]]; then
            [[ -z $operation || $operation == --list || $operation == --export ]] || return 0
        else
            [[ -z ${used[--from]} && ( -z $operation || $operation == --slot ) ]] || return 0
        fi
        local position saved_name identity remainder
        local -a identities=()
        if [[ $selector == --from ]]; then
            while read -r position identity remainder; do
                [[ $position =~ ^[0-9]+\)$ && $identity =~ ^[a-f0-9]{32}$ ]] || continue
                identities+=("$selector_prefix$identity")
            done < <(command ompi control restore "${profile_arguments[@]}" --history 2>/dev/null)
        else
            while read -r position saved_name identity remainder; do
                [[ $position =~ ^[0-9]+\)$ && $identity =~ ^[a-f0-9]{32}$ ]] || continue
                identities+=("$selector_prefix$identity")
            done < <(command ompi control restore "${profile_arguments[@]}" --list 2>/dev/null)
        fi
        COMPREPLY=( $(compgen -W "${identities[*]}" -- "$cur") )
        return 0
    fi

    local options='--profile --json'
    if [[ $action == restart ]]; then
        options+=' --no-wait'
        (( positionals > 1 )) && return 0
        if [[ $cur != -* && $positionals == 0 ]]; then
            COMPREPLY=( $(compgen -W 'all' -- "$cur") )
            return 0
        fi
    elif [[ $action == restore ]]; then
        if [[ $save == true ]]; then
            (( positionals > 2 )) && return 0
            options='--instance --profile'
        elif (( positionals > 0 )) || [[ $operation == --checkpoint || $operation == --import-legacy || $operation == --slot ]]; then
            options='--profile'
        elif [[ $operation == --list ]]; then
            options='--json --from --profile'
        elif [[ $operation == --history ]]; then
            options='--json --profile'
        elif [[ $operation == --export ]]; then
            options='--from --profile'
        elif [[ -n ${used[--from]} ]]; then
            options='--list --export --profile'
        elif [[ -n ${used[--json]} ]]; then
            options='--list --history --profile'
        else
            options='--list --checkpoint --history --from --slot --export --import-legacy --profile'
        fi
        if [[ $cur != -* && $positionals == 0 && -z $operation && -z ${used[--from]} && -z ${used[--json]} ]]; then
            local list_position saved_name remainder
            local -a names=(save)
            while read -r list_position saved_name remainder; do
                [[ $list_position =~ ^[0-9]+\)$ ]] || continue
                [[ $saved_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || continue
                names+=("$saved_name")
            done < <(command ompi control restore "${profile_arguments[@]}" --list 2>/dev/null)
            COMPREPLY=( $(compgen -W "${names[*]}" -- "$cur") )
            return 0
        fi
    elif (( positionals > 0 )); then
        return 0
    fi
    [[ $cur == -* ]] || return 0

    local option
    local -a available=()
    for option in $options; do
        [[ -n ${used[$option]} ]] || available+=("$option")
    done
    COMPREPLY=( $(compgen -W "${available[*]}" -- "$cur") )
    return 0
}

_ompi()
{
    local cur prev words cword
    _comp_initialize -n = || return
    if (( cword == 1 )); then
        _ompi_omp_completion "$@"
        [[ control == "$cur"* ]] && COMPREPLY+=(control)
        return 0
    fi
    if [[ ${words[1]} == control ]]; then
        _ompi_control_completion "$@"
    else
        _ompi_omp_completion "$@"
    fi
}

complete -F _ompi ompi
