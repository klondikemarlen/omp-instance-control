# Bash completion for the native ompi wrapper.

_ompi_omp_completion()
{
    # Reuse the installed OMP catalog, including its dynamic value completions.
    if ! declare -F _omp >/dev/null; then
        command -v omp >/dev/null 2>&1 || return 0
        local omp_registration
        omp_registration=$(complete -p omp 2>/dev/null) || omp_registration=""
        source <(command omp completions bash 2>/dev/null)
        # The delegated catalog registers omp too; only ompi belongs to us.
        if [[ -n $omp_registration ]]; then
            eval "$omp_registration"
        else
            complete -r omp 2>/dev/null || :
        fi
    fi

    if declare -F _omp >/dev/null; then
        _omp "$@"
    fi
}

_ompi_restore_completion()
{
    local cur prev words cword
    _comp_initialize -n = || return

    case "$prev" in
        --profile|--instance) return 0 ;;
        --import-legacy) _comp_compgen_filedir; return 0 ;;
    esac

    local action=""
    local have_name=false
    local selected_checkpoint=false
    local selected_slot=false
    local operation=""
    local options
    local index
    local -a profile_arguments=()
    for (( index=2; index<cword; index++ )); do
        case ${words[index]} in
            --profile)
                if [[ ${words[index+1]} == = ]]; then
                    profile_arguments=(--profile "${words[index+2]}")
                    (( index+=2 ))
                else
                    profile_arguments=(--profile "${words[index+1]}")
                    (( index++ ))
                fi
                ;;
            --profile=*) profile_arguments=(--profile "${words[index]#--profile=}") ;;
            --instance) (( index++ )) ;;
            --instance=*) ;;
            --from) selected_checkpoint=true; (( index++ )) ;;
            --from=*) selected_checkpoint=true ;;
            --slot) selected_slot=true; (( index++ )) ;;
            --slot=*) selected_slot=true ;;
            --import-legacy)
                operation=import
                if (( index+1 < cword )) && [[ ${words[index+1]} != -* ]]; then
                    (( index++ ))
                fi
                ;;
            --import-legacy=*) operation=import ;;
            --checkpoint) operation=checkpoint ;;
            --history) operation=history ;;
            --export) operation=export ;;
            --list) operation=list ;;
            save) action=save ;;
            --json|--help|-h|--version) ;;
            -*) ;;
            *) have_name=true ;;
        esac
    done

    local selector=""
    local selector_prefix=""
    local selector_value=$cur
    case "$prev" in
        --from) selector=checkpoint ;;
        --slot) selector=slot ;;
    esac
    case "$cur" in
        --from=*) selector=checkpoint; selector_prefix=--from=; selector_value=${cur#--from=} ;;
        --slot=*) selector=slot; selector_prefix=--slot=; selector_value=${cur#--slot=} ;;
    esac
    if [[ -n $selector ]]; then
        local position name identity remainder
        local -a identities=()
        if [[ $selector == checkpoint ]]; then
            while read -r position identity remainder; do
                [[ $position =~ ^[0-9]+\)$ && $identity =~ ^[a-f0-9]{32}$ ]] || continue
                identities+=("$identity")
            done < <(command ompi restore "${profile_arguments[@]}" --history 2>/dev/null)
        else
            while read -r position name identity remainder; do
                [[ $position =~ ^[0-9]+\)$ && $identity =~ ^[a-f0-9]{32}$ ]] || continue
                identities+=("$identity")
            done < <(command ompi restore "${profile_arguments[@]}" --list 2>/dev/null)
        fi
        COMPREPLY=( $(compgen -W "${identities[*]}" -- "$selector_value") )
        if [[ -n $selector_prefix ]]; then
            for index in "${!COMPREPLY[@]}"; do
                COMPREPLY[index]="$selector_prefix${COMPREPLY[index]}"
            done
        fi
        return 0
    fi

    if [[ $action == save && $have_name == false ]]; then
        return 0
    fi
    if [[ $action == save ]]; then
        options='--instance --profile --help -h --version'
    elif [[ $selected_slot == true || $have_name == true ]]; then
        options='--profile --help -h --version'
    elif [[ $operation == list ]]; then
        options='--json --from --profile --help -h --version'
    elif [[ $operation == history ]]; then
        options='--json --profile --help -h --version'
    elif [[ $operation == export ]]; then
        options='--from --profile --help -h --version'
    elif [[ $operation == checkpoint || $operation == import ]]; then
        options='--profile --help -h --version'
    elif [[ $selected_checkpoint == true ]]; then
        options='--list --export --profile --help -h --version'
    else
        options='save --list --checkpoint --history --from --slot --export --import-legacy --profile --help -h --version'
    fi
    COMPREPLY=( $(compgen -W "$options" -- "$cur") )

    if [[ $action != save && $have_name == false && -z $operation && $selected_checkpoint == false && $selected_slot == false && $cur != -* ]]; then
        local IFS=$' \t'
        local list_position saved_name remainder
        local -a saved_names=()
        while read -r list_position saved_name remainder; do
            [[ $list_position =~ ^[0-9]+\)$ ]] || continue
            [[ $saved_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || continue
            saved_names+=("$saved_name")
        done < <(command ompi restore "${profile_arguments[@]}" --list 2>/dev/null)
        COMPREPLY+=( $(compgen -W "${saved_names[*]}" -- "$cur") )
    fi
}

_ompi()
{
    local cur prev words cword
    _comp_initialize -n = || return

    if (( cword == 1 )); then
        _ompi_omp_completion "$@"
        if [[ instances == "$cur"* ]]; then
            COMPREPLY+=(instances)
        fi
        if [[ restore == "$cur"* ]]; then
            COMPREPLY+=(restore)
        fi
        return 0
    fi

    if [[ ${words[1]} == restore ]]; then
        _ompi_restore_completion "$@"
        return 0
    fi

    if [[ ${words[1]} != instances ]]; then
        _ompi_omp_completion "$@"
        return 0
    fi

    local options='--profile --json --help -h --version'
    if (( cword == 2 )); then
        COMPREPLY=( $(compgen -W "list restart cleanup $options" -- "$cur") )
        return 0
    fi

    local action=list
    case ${words[2]} in
        list|restart|cleanup) action=${words[2]} ;;
        -*) ;;
        *) return 0 ;;
    esac

    # Values are free-form here; do not mistake them for actions or options.
    case "$prev" in
        --profile|--instance) return 0 ;;
    esac
    [[ $cur == *=* ]] && return 0

    local index
    for (( index=2; index<cword; index++ )); do
        case ${words[index]} in
            --profile|--instance) (( index++ )) ;;
            --) return 0 ;;
        esac
    done

    if [[ $action == restart ]]; then
        options+=' --all --instance --no-wait'
    fi
    COMPREPLY=( $(compgen -W "$options" -- "$cur") )
    return 0
}


complete -F _ompi ompi
